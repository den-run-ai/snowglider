{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true,
    // Imported JS coverage helpers are checked by tsconfig.tests.json;
    // E2E TypeScript retains full strictness here.
    "checkJs": false
  },
  "include": ["types/**/*.d.ts", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
